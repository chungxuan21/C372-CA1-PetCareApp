<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reschedule Booking</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5" style="max-width: 640px;">
    <h1 class="h2 mb-4">Reschedule Booking #<%= booking.booking_id %></h1>

    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <div class="card mb-4">
      <div class="card-body">
        <p class="mb-1"><strong>Pet:</strong> <%= booking.pet_name %></p>
        <p class="mb-1"><strong>Service:</strong> <%= booking.service_name %></p>
        <p class="mb-1"><strong>Price:</strong> S$<%= Number(booking.booked_price).toFixed(2) %></p>
        <p class="mb-1"><strong>Current date:</strong> <%= booking.booking_date %></p>
        <p class="mb-0"><strong>Payment status:</strong>
          <% if (booking.payment_status) { %>
            <span class="badge status-badge status-<%= booking.payment_status %>"><%= booking.payment_status %></span>
          <% } else { %>
            No payment record
          <% } %>
        </p>
      </div>
    </div>

    <form action="/bookings/<%= booking.booking_id %>/reschedule" method="POST">
      <div class="mb-3">
        <label for="bookingDate" class="form-label">New booking date</label>
        <input id="bookingDate" name="bookingDate" type="date" class="form-control"
          min="<%= today %>" value="<%= booking.booking_date >= today ? booking.booking_date : today %>" required>
        <div class="form-text">Only the date changes. The price stays the same and the payment is still pending.</div>
      </div>

      <button type="submit" class="btn btn-primary">Save New Date</button>
      <a href="/bookings" class="btn btn-outline-secondary">Back to My Bookings</a>
    </form>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
