<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Pet</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Edit <%= pet.name %></h2>

    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <form action="/pets/edit/<%= pet.id %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label" for="pet_name">Pet Name:</label>
        <input type="text" class="form-control" id="pet_name" name="pet_name" value="<%= pet.name %>" maxlength="80" required>
      </div>

      <div class="mb-3">
        <label class="form-label" for="species">Species:</label>
        <input type="text" class="form-control" id="species" name="species" value="<%= pet.species %>" maxlength="50" required>
      </div>

      <div class="mb-3">
        <label class="form-label" for="breed">Breed:</label>
        <input type="text" class="form-control" id="breed" name="breed" value="<%= pet.breed %>" maxlength="80" required>
      </div>

      <div class="mb-3">
        <label class="form-label" for="age">Age:</label>
        <input type="number" class="form-control" id="age" name="age" value="<%= pet.age %>" min="0" max="100" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Current Photo:</label><br>
        <% if (pet.image) { %>
          <img src="/images/<%= pet.image %>" alt="<%= pet.name %>" class="img-thumbnail mb-2"
            style="width: 150px; height: 150px; object-fit: cover;">
        <% } else { %>
          <span class="text-secondary">No photo</span>
        <% } %>
      </div>

      <div class="mb-3">
        <label class="form-label" for="pet_image">Upload New Photo (optional):</label>
        <input type="file" class="form-control" id="pet_image" name="pet_image" accept="image/*">
        <div class="form-text">Leave empty to keep the current photo.</div>
      </div>

      <button type="submit" class="btn btn-success">Save Changes</button>
      <a href="/journals?petId=<%= pet.id %>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</body>
</html>
